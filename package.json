{
  "name": "kanza",
  "private": false,
  "version": "0.0.5",
  "type": "module",
  "main": "./dist/kanza.js",
  "module": "./dist/kanza.js",
  "types": "./dist/kanza.d.ts",
  "exports": {
    ".": {
      "types": "./dist/kanza.d.ts",
      "import": "./dist/kanza.js"
    },
